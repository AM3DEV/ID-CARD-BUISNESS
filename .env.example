# Supabase — configurez vos identifiants ici (ne commitez jamais le vrai fichier .env)
# La clé "publishable" (sb_publishable_...) équivaut à la clé ANON publique.
# NE JAMAIS exposer la SECRET KEY (sb_secret_...) dans l'application.
EXPO_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_votre-cle-publique

# remove.bg — détourage haute qualité (~50 images/mois gratuites sur https://www.remove.bg/api).
# Sans clé, l'app utilise le détourage local gratuit (Web uniquement).
EXPO_PUBLIC_REMOVEBG_API_KEY=votre-cle-remove-bg

# Hugging Face — détourage haute qualité 100 % GRATUIT (compte gratuit, sans carte).
# Créez un token sur https://huggingface.co/settings/tokens
EXPO_PUBLIC_HF_TOKEN=votre-token-huggingface
